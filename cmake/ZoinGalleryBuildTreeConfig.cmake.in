include(CMakeFindDependencyMacro)

find_dependency(Qt6 COMPONENTS
    Core Gui Quick Qml Concurrent Svg QuickControls2)
find_dependency(TIFF)
find_dependency(libraw)
find_dependency(PNG)
find_dependency(JPEG)
find_dependency(libjpeg-turbo)
find_dependency(libheif)
find_dependency(WebP)
if(@USE_EXIV2@)
    find_dependency(exiv2)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ZoinGalleryTargets.cmake")

set(ZoinGallery_QML_IMPORT_PATH "@CMAKE_CURRENT_BINARY_DIR@")
set_target_properties(ZoinGallery::Qml PROPERTIES
    QT_QML_IMPORT_PATH "${ZoinGallery_QML_IMPORT_PATH}"
    QT_QML_MODULE_OUTPUT_DIRECTORY "@CMAKE_CURRENT_BINARY_DIR@/ZoinGallery"
    QT_QML_MODULE_INSTALLED_PLUGIN_TARGET
        "ZoinGallery::ZoinGalleryQmlplugin"
    _qt_qml_module_installed_plugin_target
        "ZoinGallery::ZoinGalleryQmlplugin")

set(ZoinGallery_Core_FOUND TRUE)
set(ZoinGallery_Qml_FOUND TRUE)
